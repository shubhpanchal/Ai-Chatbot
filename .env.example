# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_NAME=AI Chat API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DEBUG=false
HTTP_SERVER_TIMEOUT_SECONDS=60
API_HOST_PORT=8001

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16+)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_chat_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434

# SQLAlchemy Async Database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/ai_chat_db
DB_CONNECT_TIMEOUT_SECONDS=5
DB_COMMAND_TIMEOUT_SECONDS=10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# -----------------------------------------------------------------------------
# Redis Configuration (Redis 7+)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6381
REDIS_DB=0
REDIS_URL=redis://localhost:6381/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CONNECT_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# Secret used as pepper for HMAC-SHA-256 API key hashing
API_KEY_SECRET=dev-secret-pepper-key-minimum-32-chars-change-in-production

# -----------------------------------------------------------------------------
# Rate Limiting & Idempotency
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# LLM Provider Configuration (OpenAI)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-test-key-placeholder
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3
DEFAULT_SYSTEM_PROMPT=You are a helpful, accurate, and concise AI assistant.
